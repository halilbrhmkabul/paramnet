{
	"name": "paramnet",
	"private": true,
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"mobile": "pnpm --filter mobile start",
		"typecheck": "pnpm -r typecheck",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "pnpm -r test",
		"db:test": "supabase test db",
		"db:types": "supabase gen types typescript --local --schema public > packages/shared/src/db.types.ts && prettier --write packages/shared/src/db.types.ts",
		"db:vectors": "node scripts/db-vectors.mjs"
	},
	"devDependencies": {
		"eslint": "^9.39.5",
		"eslint-config-expo": "~57.0.2",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"prettier": "^3.9.9",
		"supabase": "2.120.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.1"
	}
}
