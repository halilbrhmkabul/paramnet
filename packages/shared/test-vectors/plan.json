	"validate": [
		{
			"name": "uneven plan summing to the remaining amount",
			"input": {
				"principal": 2800000,
				"down_payment": 800000,
				"installments": [
					{ "due_date": "2026-11-10", "amount_minor": 500000 },
					{ "due_date": "2026-12-10", "amount_minor": 500000 },
					{ "due_date": "2027-01-10", "amount_minor": 1000000 }
				]
			},
			"expected": {
				"ok": true,
				"plan": [
					{ "seq": 1, "due_date": "2026-11-10", "amount_minor": 500000 },
					{ "seq": 2, "due_date": "2026-12-10", "amount_minor": 500000 },
					{ "seq": 3, "due_date": "2027-01-10", "amount_minor": 1000000 }
				]
			}
		},
		{
			"name": "equal consecutive dates are allowed",
			"input": {
				"principal": 300,
				"down_payment": 0,
				"installments": [
					{ "due_date": "2026-11-10", "amount_minor": 100 },
					{ "due_date": "2026-11-10", "amount_minor": 200 }
				]
			},
			"expected": {
				"ok": true,
				"plan": [
					{ "seq": 1, "due_date": "2026-11-10", "amount_minor": 100 },
					{ "seq": 2, "due_date": "2026-11-10", "amount_minor": 200 }
				]
			}
		},
		{
			"name": "single installment without due date",
			"input": {
				"principal": 300,
				"down_payment": 100,
				"installments": [{ "due_date": null, "amount_minor": 200 }]
			},
			"expected": {
				"ok": true,
				"plan": [{ "seq": 1, "due_date": null, "amount_minor": 200 }]
			}
		},
		{
			"name": "down payment equal to principal",
			"input": {
				"principal": 300,
				"down_payment": 300,
				"installments": [{ "due_date": null, "amount_minor": 1 }]
			},
			"expected": { "ok": false, "error": "down_payment_too_large" }
		},
		{
			"name": "no rows",
			"input": {
				"principal": 300,
				"down_payment": 0,
				"installments": []
			},
			"expected": { "ok": false, "error": "empty_plan" }
		},
		{
			"name": "zero amount row",
			"input": {
				"principal": 300,
				"down_payment": 0,
				"installments": [
					{ "due_date": "2026-11-10", "amount_minor": 300 },
					{ "due_date": "2026-12-10", "amount_minor": 0 }
				]
			},
			"expected": { "ok": false, "error": "non_positive_installment", "index": 1 }
		},
		{
			"name": "fractional amount row",
			"input": {
				"principal": 300,
				"down_payment": 0,
				"installments": [
					{ "due_date": "2026-11-10", "amount_minor": 150.5 },
					{ "due_date": "2026-12-10", "amount_minor": 149.5 }
				]
			},
			"expected": { "ok": false, "error": "non_positive_installment", "index": 0 }
		},
		{
			"name": "rows do not add up to the remaining amount",
			"input": {
				"principal": 300,
				"down_payment": 100,
				"installments": [
					{ "due_date": "2026-11-10", "amount_minor": 100 },
					{ "due_date": "2026-12-10", "amount_minor": 101 }
				]
			},
			"expected": { "ok": false, "error": "sum_mismatch" }
		},
		{
			"name": "a date earlier than the previous row",
			"input": {
				"principal": 300,
				"down_payment": 0,
				"installments": [
					{ "due_date": "2026-11-10", "amount_minor": 100 },
					{ "due_date": "2026-12-10", "amount_minor": 100 },
					{ "due_date": "2026-12-09", "amount_minor": 100 }
				]
			},
			"expected": { "ok": false, "error": "dates_not_ascending", "index": 2 }
		},
		{
			"name": "missing due date in a multi-row plan",
			"input": {
				"principal": 300,
				"down_payment": 0,
				"installments": [
					{ "due_date": "2026-11-10", "amount_minor": 100 },
