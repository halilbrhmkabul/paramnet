{
	"description": "Plan generation and validation vectors shared by packages/shared (Vitest) and the plpgsql implementation (pgTAP). Amounts are kuruş, dates are ISO calendar days. Expected values are hand-written, not produced by the implementation.",
	"generate": [
		{
			"name": "spec 5.2 furniture: 28.000 TL, 8.000 down, 5 monthly from 10 Nov 2026",
			"input": {
				"principal": 2800000,
				"down_payment": 800000,
				"count": 5,
				"period": "monthly",
				"first_due_date": "2026-11-10"
			},
			"expected": {
				"ok": true,
				"plan": [
					{ "seq": 1, "due_date": "2026-11-10", "amount_minor": 400000 },
					{ "seq": 2, "due_date": "2026-12-10", "amount_minor": 400000 },
					{ "seq": 3, "due_date": "2027-01-10", "amount_minor": 400000 },
					{ "seq": 4, "due_date": "2027-02-10", "amount_minor": 400000 },
					{ "seq": 5, "due_date": "2027-03-10", "amount_minor": 400000 }
				]
			}
		},
