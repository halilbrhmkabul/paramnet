# Server-side only (never exposed to the browser).
FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Cloudflare Turnstile site key (public); empty locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Deep links (F2-05): Apple team id and Android release signing SHA-256 fingerprints (comma separated).
APPLE_TEAM_ID=
ANDROID_SHA256_CERT_FINGERPRINTS=

# Sentry, server side only (F3-01, ADR-037): empty = off. Use an EU-region project (KVKK).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
