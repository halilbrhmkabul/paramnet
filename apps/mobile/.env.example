# Copy to .env.local (not committed) and restart Metro.
# mock: in-memory prototype data and fake OTP (123456 for any number).
# supabase: local Supabase (`pnpm supabase start`); only +905550000001/2/3 receive the test code 123456.
EXPO_PUBLIC_API_MODE=mock

# Expo Go on a phone cannot reach 127.0.0.1 of your Mac; use the Mac's LAN IP (shown by `pnpm mobile`).
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
# Publishable (anon) key from `pnpm supabase status`. Never put the secret / service role key here.
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx

# Invite link domain (deep-links.md); empty until decided. Enables Universal Links / App Links.
EXPO_PUBLIC_APP_DOMAIN=

# Menü > "Yardım ve destek" opens a mail to this address; empty hides the row (not decided yet).
EXPO_PUBLIC_SUPPORT_EMAIL=

# Sentry (F3-01, ADR-037): empty = error reporting off. Use an EU-region project (KVKK, spec 12).
EXPO_PUBLIC_SENTRY_DSN=
# development | staging | production (defaults to development in dev builds, production otherwise).
EXPO_PUBLIC_SENTRY_ENV=

# Mock mode only: start signed in as a demo account (design checks in the simulator).
EXPO_PUBLIC_MOCK_SIGNED_IN=
