# mock | supabase — ekranlar hangi src/api adaptörünün çalıştığını bilmez
EXPO_PUBLIC_API_MODE=mock
# Davet linklerinin alan adı (Faz 2)
EXPO_PUBLIC_APP_DOMAIN=
# Yalnızca anon anahtar. Servis rolü anahtarı istemciye asla girmez.
# Yerel: `pnpm supabase status` çıktısındaki API_URL ve PUBLISHABLE_KEY.
# Telefondaki Expo Go için 127.0.0.1 yerine bilgisayarın LAN IP'si kullanılır.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
