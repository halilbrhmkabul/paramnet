# Local values for `pnpm supabase functions serve --env-file supabase/functions/.env.example`.
# Production uses `supabase secrets set` with real values; nothing here is a real secret.
INVITE_SESSION_SECRET=local-only-invite-session-secret-change-me
# F4-01b (ADR-049): key for the password Auth stores in place of the PIN; at least 32 characters.
# Production: `supabase secrets set PIN_PEPPER=...` once; changing it invalidates every PIN.
PIN_PEPPER=local-only-pin-pepper-change-me-0123456789
# SMS (F3-04, ADR-040): test = only +905550000001/2/3 (code 123456, nothing sent); log = codes in the
# function log (local stack only); netgsm = real SMS with the NETGSM_* values below.
SMS_MODE=test
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
# Same local-only value as [auth.hook.send_sms] in supabase/config.toml.
SEND_SMS_HOOK_SECRET=v1,whsec_LEDfQQdoH7a7+NnMNb9ZAmFeq5aRiucyLD4yLr2LEow=
# Local only. In production set TURNSTILE_SECRET_KEY instead.
TURNSTILE_DISABLED=1

# Sentry (F3-01, ADR-037): empty = off. Production: `supabase secrets set SENTRY_DSN=...` (EU region).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
